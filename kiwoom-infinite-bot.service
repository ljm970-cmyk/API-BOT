[Unit]
Description=Kiwoom Infinite Buy Bot (KST Fixed)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kiwoom-infinite-buy

# ⭐ 핵심: KST 환경변수 영구 고정
Environment="TZ=Asia/Seoul"
Environment="PYTHONUTF8=1"
Environment="daemon_name=kiwoom-infinite-bot"   # ⭐ 추가됨

ExecStart=/home/ubuntu/kiwoom-infinite-buy/.venv/bin/python3 -m telegram_bot
ExecStartPre=/bin/bash -c 'timedatectl set-timezone Asia/Seoul || true'

Restart=always
RestartSec=5                                    # 10→5초 (더 빠른 부활)

[Install]
WantedBy=multi-user.target
